# Livepeer Video Gateway — env vars consumed by docker-compose.yml.
# Copy to `.env` and fill in.
#
# Default values (in compose) are dev-only. For production, set
# everything below.

# ── Postgres ────────────────────────────────────────────────────────
POSTGRES_DB=video_gateway
POSTGRES_USER=video_gateway
POSTGRES_PASSWORD=please-change-me
POSTGRES_HOST_PORT=5432

# ── Gateway HTTP ────────────────────────────────────────────────────
BASE_URL=https://api.example.com
PUBLIC_SITE_URL=https://example.com
PUBLIC_PORTAL_URL=https://portal.example.com
ALLOWED_ORIGINS=https://example.com,https://portal.example.com,https://admin.example.com
LOG_LEVEL=info
GATEWAY_HOST_PORT=4000

# ── SaaS shell auth — REQUIRED in production ───────────────────────
ADMIN_TOKEN=
API_KEY_HASH_PEPPER=
IP_HASH_PEPPER=
METRICS_TOKEN=
SESSION_TTL_HOURS=24

# ── Email (optional — without this, verification + key emails log to
#    stdout instead of sending) ─────────────────────────────────────
RESEND_API_KEY=
# Optional override for the resend-go SDK base URL. Useful for a proxy,
# mock server, or non-default Resend-compatible endpoint.
RESEND_BASE_URL=https://api.resend.com/
FROM_EMAIL=Livepeer Video Gateway <noreply@example.com>

# ── MinIO / S3 (VOD ingest and ABR artifacts) ───────────────────────
# Live HLS playback comes from the runner runtime descriptor.
MINIO_ROOT_USER=minio_root
MINIO_ROOT_PASSWORD=please-change-me
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_BUCKET=lvp-video-ingest
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=video-gateway
S3_SECRET_ACCESS_KEY=please-change-me
S3_PRESIGN_TTL_SECONDS=3600

# ── LOC (Livepeer Open Clearinghouse) ──────────────────────────────
# LOC owns funding and route selection. The gateway signs delegated caller
# proofs using a persistent secp256k1 key. Both keys below are required when
# LOC_API_KEY is set. Generate once; back them up securely with the database.
LOC_BASE_URL=https://loc.cloudspe.com
LOC_API_KEY=
# 64 hex characters (32 bytes), e.g. openssl rand -hex 32
LOC_CALLER_PRIVATE_KEY=
# Base64 32 bytes for AES-GCM, e.g. openssl rand -base64 32
OPERATION_SECRETS_KEY=
# Capability-catalog refresh cadence (sources LOC GET /v1/capabilities).
REGISTRY_REFRESH_INTERVAL_MS=60000

# ── /api/v1/* rate limit ──────────────────────────────────────────
# Per-API-key token bucket. burst = max tokens accumulated;
# per_minute = refill rate.
V1_RATE_LIMIT_PER_MINUTE=60
V1_RATE_LIMIT_BURST=30

# ── Image tags ─────────────────────────────────────────────────────
MINIO_IMAGE_TAG=latest
GATEWAY_TAG=dev

# ── Transcode capability defaults ─────────────────────────────────
# Capability identifiers the gateway expects on the network. Override
# only if the supply side advertises different names.
ABR_CAPABILITY=video:transcode.abr
ABR_OFFERING=abr-default
# Hard authorization ceiling in video-frame-megapixel units (not seconds).
ABR_MAX_TOTAL_UNITS=1000000
ABR_JOB_TIMEOUT_SECS=3600
LIVE_CAPABILITY=video:transcode.live
LIVE_GATEWAY_INGEST_OFFERING=gateway-ingest

# ── paid-session/v1 tuning ────────────────────────────────────────
# Positive cadence required. Recovery scans every two seconds; idle policy
# is configured on the runner.
LIVE_RECONCILE_INTERVAL_SECS=30
LIVE_TOPUP_RUNWAY_THRESHOLD_SECS=60
LIVE_TOPUP_FUND_SECS=60
# Lifetime authorization ceiling in whole output_seconds, NOT milliseconds.
LIVE_MAX_TOTAL_UNITS=6000
LIVE_OUTPUT_PROFILE=live-standard
LIVE_METERING_RENDITION=720p

# ── Gateway-owned RTMP relay ──────────────────────────────────────
# Set 0 to disable the listener. The compose TCP mapping stays on 1935;
# if changing the listener port, update the compose target port to match.
LIVE_RTMP_PORT=1935
LIVE_RTMP_HOST_PORT=1935
# Explicit public server root, without the customer stream key.
LIVE_EXTERNAL_RTMP_URL=rtmp://localhost:1935/live
